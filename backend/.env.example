# Application
APP_NAME=TruEstate API
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
# Development (SQLite - default)
DATABASE_URL=sqlite+aiosqlite:///./truestate.db

# Production (PostgreSQL on Render - uncomment and update with your values)
# External URL (for local testing):
# DATABASE_URL=postgresql://truestate_prod_user:YOUR_PASSWORD@dpg-xxxxx-a.virginia-postgres.render.com/truestate_prod
# Internal URL (for Render deployment - use this in Render environment variables):
# DATABASE_URL=postgresql://truestate_prod_user:YOUR_PASSWORD@dpg-xxxxx-a/truestate_prod

# Caching
CACHE_BACKEND=memory
# For Redis (optional):
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=30
CACHE_MAX_SIZE=1000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.github.io

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
