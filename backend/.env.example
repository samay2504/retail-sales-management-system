# Application
APP_NAME=TruEstate API
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./truestate.db
# For PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/truestate

# Caching
CACHE_BACKEND=memory
# For Redis (optional):
# CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL=30
CACHE_MAX_SIZE=1000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://*.github.io

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
